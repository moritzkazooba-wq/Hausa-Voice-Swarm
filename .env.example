# ── LLM Configuration ────────────────────────────────────────────────
MOCK_LLM=true
OPENAI_API_KEY=sk-xxx
GOOGLE_API_KEY=xxx
LITELLM_LOG=DEBUG

# ── ASR / TTS ────────────────────────────────────────────────────────
USE_REAL_ASR=false
USE_REAL_TTS=false
INTRON_API_KEY=xxx

# ── Voice Transport ──────────────────────────────────────────────────
DAILY_API_KEY=xxx
DAILY_ROOM_URL=https://your-domain.daily.co/room
TELEPHONY_PROVIDER=daily

# ── Database ─────────────────────────────────────────────────────────
COCKROACHDB_URL=postgresql+asyncpg://root@localhost:26257/defaultdb?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# ── Kafka ────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Application ──────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
HOST=0.0.0.0
PORT=8000
